# AWS Configuration
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=cloudfinops-data
USE_LOCAL_S3_MOCK=true

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=aws_finops_knowledge

# Embedding Models (fastembed — uses ONNX, no PyTorch required)
DENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Batch & Local Data Paths
DATA_DIR=./data
ANOMALIES_FILE=./data/anomalies/anomalies_detected.json
